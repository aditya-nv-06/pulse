DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulse"
NODE_ENV=development
PORT=4000
# Public frontend origin. Set to the deployed frontend origin for cookie/CORS access.
CLIENT_ORIGIN="http://localhost:5173"
# Public frontend URL used for sign-in links and redirects.
APP_URL="http://localhost:5173"
RESEND_API_KEY=""
RESEND_FROM="Pulse <onboarding@resend.dev>"
# Use a matching key ID and secret from the same Razorpay account and test/live mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_PLAN_ID=""
XAI_API_KEY=""
XAI_MODEL="grok-4-1-fast-reasoning"
XAI_BASE_URL="https://api.x.ai/v1"
# Optional Cloudflare AI configuration. Needed for AI image and fallback features.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"
CLOUDFLARE_IMAGE_MODEL="black-forest-labs/flux-3-image-klein"
