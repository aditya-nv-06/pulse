{
  "$schema": "./server/node_modules/wrangler/config-schema.json",
  "name": "pulse",
  "main": "server/src/worker.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "production",
    "CLIENT_ORIGIN": "https://pulse.feedbackloop.workers.dev",
    "APP_URL": "https://pulse.feedbackloop.workers.dev",
    "BREVO_SENDER_EMAIL": "adityanv4@gmail.com",
  },
  "secrets": {
    "required": ["DATABASE_URL", "BREVO_API_KEY"],
  },
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
