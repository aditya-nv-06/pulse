{
  "$schema": "./server/node_modules/wrangler/config-schema.json",
  "name": "pulse",
  "main": "server/src/worker.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "production",
    "CLIENT_ORIGIN": "REPLACE_WITH_WORKER_ORIGIN",
    "APP_URL": "REPLACE_WITH_WORKER_ORIGIN",
    "RESEND_FROM": "REPLACE_WITH_VERIFIED_RESEND_FROM",
  },
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "replace-with-hyperdrive-config-id",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/pulse",
    },
  ],
}
