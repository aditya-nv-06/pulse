{
  "$schema": "./server/node_modules/wrangler/config-schema.json",
  "name": "pulse",
  "main": "server/src/worker.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "production",
    "CLIENT_ORIGIN": "https://pulse.feedbackloop.workers.dev",
    "APP_URL": "https://pulse.feedbackloop.workers.dev",
    "BREVO_SENDER_EMAIL": "adityanv4@gmail.com",
  },
  "secrets": {
    "required": ["DATABASE_URL", "BREVO_API_KEY", "RAZORPAY_KEY_ID", "RAZORPAY_KEY_SECRET"],
  },
  "ratelimits": [
    {
      "name": "SITE_RATE_LIMITER",
      "namespace_id": "901000",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "901001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "MAGIC_LINK_IP_RATE_LIMITER",
      "namespace_id": "901002",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "MAGIC_LINK_EMAIL_RATE_LIMITER",
      "namespace_id": "901003",
      "simple": { "limit": 1, "period": 60 },
    },
  ],
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
