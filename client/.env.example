# Use /api when the frontend and backend share an origin or a reverse proxy routes /api.
# For separate deployments, set this to the backend URL including /api before building.
VITE_API_URL=/api

# Public Razorpay key ID only (never put the key secret in frontend variables).
# It must match RAZORPAY_KEY_ID in server/.env.
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key
